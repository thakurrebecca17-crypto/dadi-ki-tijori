<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dadi Ki Tijori | Har bite mein ghar ki yaad</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = { theme: { extend: { colors: {
  pickle:'#2F4A35', pickledark:'#183D2B', cream:'#F7F1E5', beige:'#DFD2B9', brown:'#6B4632', gold:'#C49A58'
}, fontFamily: { serif:['Playfair Display','serif'], sans:['Inter','sans-serif'] } } } }
</script>
<style>
:root{ box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px); }
html{scroll-behavior:smooth; scroll-padding-top:70px;}
body{background:#F7F1E5; overflow-x:hidden;
cursor: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><text y=%2224%22 font-size=%2224%22>🥒</text></svg>') 16 16, auto;}
a,button,[data-flip]{cursor: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><text y=%2224%22 font-size=%2224%22>🗝️</text></svg>') 16 16, pointer;}
@media (pointer:coarse){ body,a,button,[data-flip]{cursor:auto;} }
.float{position:absolute; animation:floaty 7s ease-in-out infinite; opacity:.55; pointer-events:none; user-select:none;}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(-18px) rotate(8deg);}}
.reveal{opacity:0; transform:translateY(24px); transition:all .8s cubic-bezier(.2,.7,.3,1);}
.reveal.show{opacity:1; transform:translateY(0);}
.flip-card{perspective:1200px;}
.flip-inner{transition:transform .7s cubic-bezier(.2,.7,.3,1); transform-style:preserve-3d; position:relative; min-height:430px;}
.flip-card.flipped .flip-inner{transform:rotateY(180deg);}
.flip-front,.flip-back{position:absolute; inset:0; backface-visibility:hidden; border-radius:1rem;}
.flip-back{transform:rotateY(180deg);}
@media(hover:hover){ .flip-card:hover .flip-inner{transform:rotateY(180deg);} }
.bingo-cell.marked{background:#2F4A35; color:#F7F1E5; transform:scale(.96);}
.cart-drawer{transition:transform .5s cubic-bezier(.2,.7,.3,1);}
::-webkit-scrollbar{width:8px;} ::-webkit-scrollbar-thumb{background:#C49A58; border-radius:4px;}
.burst{position:fixed;pointer-events:none;z-index:9999;font-size:20px;transition:transform .9s cubic-bezier(.1,.7,.3,1),opacity .9s;}
.fall{position:fixed;top:-50px;pointer-events:none;z-index:30;animation:fall linear forwards;}
@keyframes fall{to{transform:translateY(112vh) rotate(var(--r));opacity:.9;}}
.w{display:inline-block;white-space:nowrap;}
.ch{display:inline-block;transition:transform .35s cubic-bezier(.3,1.6,.5,1),color .3s;}
.ch:hover{transform:translateY(-10px) rotate(-6deg) scale(1.25);color:#C49A58;}
main p,section p{transition:transform .4s ease,color .3s;}
section p:hover{transform:translateX(6px);}
</style>
</head>
<body class="font-sans text-pickledark">

<!-- NAV -->
<nav class="fixed top-0 w-full z-50 bg-cream/90 backdrop-blur border-b border-beige" style="padding-top:env(safe-area-inset-top,0px)">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 py-3">
    <div class="flex items-center gap-2">
      <img id="img-logo" src="data:image/jpeg;base64," class="h-10 w-10 rounded-full object-cover" alt="logo">
      <span class="font-serif font-bold text-lg text-pickle hidden sm:block">DADI KI TIJORI</span>
    </div>
    <div class="hidden md:flex gap-6 text-sm font-medium">
      <a href="#home" class="hover:text-gold">HOME</a>
      <a href="#story" class="hover:text-gold">OUR STORY</a>
      <a href="#flavours" class="hover:text-gold">FLAVOURS</a>
      <a href="#shop" class="hover:text-gold">SHOP</a>
      <a href="#campaign" class="hover:text-gold">CAMPAIGN</a>
      <a href="#feedback" class="hover:text-gold">FEEDBACK</a>
      <a href="#contact" class="hover:text-gold">CONTACT</a>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="toggleCart(true)" class="relative">🧺<span id="cartCount" class="absolute -top-2 -right-2 bg-gold text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span></button>
      <button class="md:hidden" onclick="document.getElementById('mmenu').classList.toggle('hidden')">☰</button>
    </div>
  </div>
  <div id="mmenu" class="hidden md:hidden flex flex-col gap-3 px-4 pb-4 text-sm font-medium">
    <a href="#home">HOME</a><a href="#story">OUR STORY</a><a href="#flavours">FLAVOURS</a><a href="#shop">SHOP</a><a href="#campaign">CAMPAIGN</a><a href="#feedback">FEEDBACK</a><a href="#contact">CONTACT</a>
  </div>
</nav>

<!-- HERO -->
<section id="home" class="relative min-h-screen flex items-center pt-24 overflow-hidden bg-gradient-to-b from-cream to-beige">
  <span class="float text-4xl" style="top:12%;left:6%">🥭</span>
  <span class="float text-3xl" style="top:70%;left:10%;animation-delay:1s">🌶️</span>
  <span class="float text-3xl" style="top:20%;right:8%;animation-delay:2s">🍋</span>
  <span class="float text-3xl" style="top:60%;right:12%;animation-delay:1.5s">🌿</span>
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
    <div class="reveal show">
      <h1 class="font-serif text-4xl md:text-6xl font-extrabold text-pickle leading-tight">THE TASTE OF HOME,<br>KEPT LIKE A TREASURE.</h1>
      <p class="mt-4 text-lg text-brown">Traditional Indian pickles, reimagined for today.</p>
      <p class="mt-1 italic text-gold">Har bite mein ghar ki yaad.</p>
      <div class="mt-8 flex gap-4 flex-wrap">
        <a href="#shop" class="bg-pickle text-cream px-6 py-3 rounded-full font-semibold hover:bg-pickledark transition">SHOP THE TIJORI</a>
        <a href="#flavours" class="border-2 border-pickle text-pickle px-6 py-3 rounded-full font-semibold hover:bg-pickle hover:text-cream transition">EXPLORE FLAVOURS</a>
      </div>
    </div>
    <img id="img-hero" src="data:image/jpeg;base64," class="rounded-2xl shadow-2xl reveal show" alt="Dadi Ki Tijori pickles">
  </div>
</section>

<!-- STORY -->
<section id="story" class="relative py-24 bg-pickle text-cream overflow-hidden">
  <span class="float text-3xl" style="top:10%;left:4%">🫙</span>
  <span class="float text-3xl" style="bottom:8%;right:6%;animation-delay:2s">🌿</span>
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-5xl font-bold">SOME RECIPES ARE INHERITED.<br>SOME ARE TREASURED.</h2>
    <p class="reveal mt-6 text-beige leading-relaxed">DADI KI TIJORI was inspired by the timeless tradition of homemade Indian pickles — flavours passed down through generations and treasured in every family. The Tijori represents something precious that is carefully kept and protected. We took that idea and turned it into a modern pickle brand that celebrates traditional taste while making it part of everyday life.</p>
    <img src="data:image/jpeg;base64," class="reveal mt-10 mx-auto rounded-2xl shadow-2xl w-full max-w-md" alt="Homemade pickle jar">
    <div class="reveal mt-12 flex flex-wrap justify-center gap-4 font-serif font-semibold text-lg">
      <span class="bg-cream/10 px-5 py-3 rounded-full">HOME KITCHEN</span><span>↓</span>
      <span class="bg-cream/10 px-5 py-3 rounded-full">PICKLE</span><span>↓</span>
      <span class="bg-cream/10 px-5 py-3 rounded-full">TREASURE</span><span>↓</span>
      <span class="bg-gold text-pickledark px-5 py-3 rounded-full">DADI KI TIJORI</span>
    </div>
  </div>
</section>

<!-- FLAVOURS -->
<section id="flavours" class="py-24 bg-cream">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-5xl font-bold text-pickle">A FLAVOUR FOR EVERY MEMORY</h2>
    <p class="reveal mt-2 text-brown">Four flavours. One treasured tradition.</p>
    <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- cards injected by JS -->
      <div id="flavourGrid" class="contents"></div>
    </div>
  </div>
</section>

<!-- SHOP -->
<section id="shop" class="py-24 bg-beige">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-5xl font-bold text-pickle">OPEN YOUR TIJORI</h2>
    <p class="reveal mt-2 text-brown">Choose your jar. Pick your flavour. Bring home a little taste of tradition.</p>
    <div id="productGrid" class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-6"></div>

    <div class="mt-20">
      <h3 class="font-serif text-2xl font-bold text-pickle mb-8">HOW TO ORDER</h3>
      <div class="grid sm:grid-cols-4 gap-6 text-left">
        <div class="reveal bg-cream rounded-xl p-5"><span class="text-gold font-serif text-2xl">01</span><p class="font-semibold mt-1">DISCOVER</p><p class="text-sm text-brown">Explore our flavours.</p></div>
        <div class="reveal bg-cream rounded-xl p-5"><span class="text-gold font-serif text-2xl">02</span><p class="font-semibold mt-1">CHOOSE</p><p class="text-sm text-brown">Pick your favourite Tijori.</p></div>
        <div class="reveal bg-cream rounded-xl p-5"><span class="text-gold font-serif text-2xl">03</span><p class="font-semibold mt-1">ORDER</p><p class="text-sm text-brown">Order via WhatsApp or email.</p></div>
        <div class="reveal bg-cream rounded-xl p-5"><span class="text-gold font-serif text-2xl">04</span><p class="font-semibold mt-1">ENJOY</p><p class="text-sm text-brown">Open your jar & enjoy.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- CAMPAIGN -->
<section id="campaign" class="py-24 bg-pickledark text-cream">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-5xl font-bold">BUILD TRUST</h2>
    <p class="reveal mt-2 text-beige">Experiential & Community</p>
    <div class="mt-14 grid sm:grid-cols-2 gap-6 text-left">
      <div class="reveal bg-cream/10 rounded-xl p-6"><p class="font-serif text-xl font-bold text-gold">PICKLE-MAKING WORKSHOP</p><p class="mt-2 text-sm text-beige">A hands-on session teaching a simple pickle recipe — memorable on its own, and generating content for the brand afterwards. Weekend sessions, small groups, local communities. Participants make and take home their own jar.</p><p class="mt-3 font-semibold">LEARN. MAKE. TAKE HOME.</p></div>
      <div class="reveal bg-cream/10 rounded-xl p-6"><p class="font-serif text-xl font-bold text-gold">STREET FOOD CART COLLAB</p><p class="mt-2 text-sm text-beige">A limited-time "DADI KI TIJORI × VADA PAV" pickle special with a local street-food cart, introducing our pickle through an existing local food community.</p><p class="mt-3 font-semibold">SAME TASTE. NEW PLACES.</p></div>
      <div class="reveal bg-cream/10 rounded-xl p-6"><p class="font-serif text-xl font-bold text-gold">RECIPE CARD / QR AT CHECKOUT</p><p class="mt-2 text-sm text-beige">Every purchase includes a recipe card / QR leading to "5 Ways to Use Our Pickle" — sandwiches, rice, salads, paratha, wraps — beyond roti-sabzi.</p></div>
      <div class="reveal bg-cream/10 rounded-xl p-6"><p class="font-serif text-xl font-bold text-gold">COMMUNITY VIBE</p><p class="mt-2 text-sm text-beige">Built through WhatsApp groups, customer reviews, word of mouth & customer-generated content. "Have you tried DADI KI TIJORI?"</p><p class="mt-3 font-semibold">REAL PEOPLE. REAL FLAVOURS. REAL MOMENTS.</p></div>
    </div>
  </div>
</section>

<!-- BINGO -->
<section id="bingo" class="py-24 bg-cream">
  <div class="max-w-2xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-4xl font-bold text-pickle">HOW DO YOU LIKE YOUR ACHAAR?</h2>
    <p class="reveal mt-2 text-brown">Tap the squares that sound like you.</p>
    <div id="bingoGrid" class="mt-8 grid grid-cols-5 gap-1 sm:gap-2"></div>
    <p class="mt-6 font-semibold text-pickle">SCREENSHOT & SHARE — TAG @DADIKITIJORI</p>
  </div>
</section>

<!-- FEEDBACK -->
<section id="feedback" class="py-24 bg-beige">
  <div class="max-w-xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-4xl font-bold text-pickle">TELL US WHAT'S IN YOUR TIJORI</h2>
    <p class="reveal mt-2 text-brown">Your feedback helps us make every jar better.</p>
    <form id="feedbackForm" class="reveal mt-8 bg-cream rounded-xl p-6 text-left space-y-3" onsubmit="return submitFeedback(event)">
      <input required placeholder="Name" class="w-full p-3 rounded border border-beige">
      <input required type="email" placeholder="Email" class="w-full p-3 rounded border border-beige">
      <select class="w-full p-3 rounded border border-beige">
        <option>Aam Ki Tijori</option><option>Nimbu Ki Tijori</option><option>Mirchi Ki Tijori</option><option>Mixed Tijori</option>
      </select>
      <div id="stars" class="flex gap-1 text-2xl">
        <span data-v="1">⭐</span><span data-v="2">⭐</span><span data-v="3">⭐</span><span data-v="4">⭐</span><span data-v="5">⭐</span>
      </div>
      <textarea placeholder="Feedback" class="w-full p-3 rounded border border-beige" rows="3"></textarea>
      <button class="w-full bg-pickle text-cream py-3 rounded-full font-semibold hover:bg-pickledark">LOCK IT IN 🗝️</button>
    </form>
    <p id="feedbackThanks" class="hidden mt-4 font-serif text-xl text-pickle">Thank you for unlocking your feedback. 🗝️</p>
  </div>
</section>

<!-- INSTAGRAM + CONTACT -->
<section id="contact" class="py-24 bg-pickle text-cream text-center">
  <h2 class="reveal font-serif text-3xl md:text-4xl font-bold">FOLLOW THE TIJORI</h2>
  <p class="reveal mt-2 text-beige">See what's cooking, what's being opened and what our community is loving.</p>
  <a target="_blank" href="https://www.instagram.com/dadikitijori?stkn=MTFhaHEydzZ1Y2l6Yg==" class="reveal inline-block mt-4 bg-gold text-pickledark px-6 py-3 rounded-full font-semibold">FOLLOW US ON INSTAGRAM</a>

  <h2 class="reveal font-serif text-3xl md:text-4xl font-bold mt-20">FROM OUR TIJORI TO YOUR TABLE.</h2>
  <div class="reveal mt-6 flex flex-wrap justify-center gap-4">
    <a href="tel:9892514051" class="bg-cream/10 px-5 py-3 rounded-full">📞 CALL</a>
    <a target="_blank" href="https://wa.me/919892514051" class="bg-cream/10 px-5 py-3 rounded-full">💬 WHATSAPP</a>
    <a href="mailto:dadikitijori@gmail.com" class="bg-cream/10 px-5 py-3 rounded-full">✉️ EMAIL</a>
    <a target="_blank" href="https://www.instagram.com/dadikitijori?stkn=MTFhaHEydzZ1Y2l6Yg==" class="bg-cream/10 px-5 py-3 rounded-full">📷 INSTAGRAM</a>
  </div>
</section>

<footer class="bg-pickledark text-beige py-12 text-center relative overflow-hidden">
  <span class="float text-2xl" style="top:10%;left:6%">🥭</span><span class="float text-2xl" style="top:15%;right:8%;animation-delay:1s">🍋</span>
  <p class="font-serif text-2xl font-bold text-cream">DADI KI TIJORI</p>
  <p class="italic mt-1">Har bite mein ghar ki yaad.</p>
  <div class="mt-4 flex flex-wrap justify-center gap-4 text-sm">
    <a href="#home">Home</a><a href="#story">Our Story</a><a href="#flavours">Flavours</a><a href="#shop">Shop</a><a href="#campaign">Campaign</a><a href="#feedback">Feedback</a><a href="#contact">Contact</a>
  </div>
  <p class="mt-6 text-xs tracking-widest">TRADITIONAL TASTE. TIMELESS MEMORIES.</p>
</footer>

<!-- CART DRAWER -->
<div id="cartOverlay" onclick="toggleCart(false)" class="hidden fixed inset-0 bg-black/40 z-40"></div>
<div id="cartDrawer" class="cart-drawer fixed top-0 right-0 h-full w-full sm:w-96 bg-cream z-50 translate-x-full shadow-2xl flex flex-col" style="padding-top:env(safe-area-inset-top,0px)">
  <div class="flex justify-between items-center p-5 border-b border-beige">
    <p class="font-serif text-xl font-bold text-pickle">Your Tijori</p>
    <button onclick="toggleCart(false)" class="text-2xl">✕</button>
  </div>
  <div id="cartItems" class="flex-1 overflow-y-auto p-5 space-y-4"></div>
  <div class="p-5 border-t border-beige">
    <div class="flex justify-between font-semibold mb-3"><span>Total</span><span id="cartTotal">₹0</span></div>
    <button onclick="showCheckout()" class="w-full bg-pickle text-cream py-3 rounded-full font-semibold hover:bg-pickledark">PROCEED TO ORDER</button>
    <div id="checkoutForm" class="hidden mt-4 space-y-2 text-sm">
      <input id="cName" placeholder="Full Name" class="w-full p-2 rounded border border-beige">
      <input id="cPhone" placeholder="Phone Number" class="w-full p-2 rounded border border-beige">
      <input id="cAddress" placeholder="Address" class="w-full p-2 rounded border border-beige">
      <input id="cCity" placeholder="City" class="w-full p-2 rounded border border-beige">
      <input id="cPin" placeholder="Pincode" class="w-full p-2 rounded border border-beige">
      <button onclick="orderWhatsapp()" class="w-full bg-green-700 text-white py-2 rounded-full font-semibold mt-2">Place Order & Confirm on WhatsApp</button>
      <button onclick="orderEmail()" class="w-full border-2 border-pickle text-pickle py-2 rounded-full font-semibold">SEND VIA EMAIL</button>
    </div>
  </div>
</div>

<script>
const flavours=[
 {id:'aam',name:'Aam Ki Tijori',sub:'Mango Pickle',img:'data:image/jpeg;base64,',back:'Classic. Bold. Nostalgic. A familiar mango pickle that instantly brings the taste of home to the table.',emoji:'🥭'},
 {id:'nimbu',name:'Nimbu Ki Tijori',sub:'Lemon Pickle',img:'data:image/jpeg;base64,',back:'Tangy. Bright. Refreshing. A sharper, zesty flavour for people who love a little extra kick with their meals.',emoji:'🍋'},
 {id:'mirchi',name:'Mirchi Ki Tijori',sub:'Chilli Pickle',img:'data:image/jpeg;base64,',back:'Bold. Spicy. Unapologetic. For people who like their pickle with a little heat and a lot of flavour.',emoji:'🌶️'},
 {id:'mixed',name:'Mixed Tijori',sub:'Mixed Pickle',img:'data:image/jpeg;base64,',back:'Colourful. Complex. Full of flavour. A little bit of everything, bringing different textures and tastes into one jar.',emoji:'🥗'}
];
const sizes=[{label:'TRIAL 100g',price:59},{label:'REGULAR 250g',price:129},{label:'FAMILY 500g',price:229},{label:'TIJORI COMBO 3×250g',price:349}];

const fg=document.getElementById('flavourGrid');
flavours.forEach(f=>{
 fg.innerHTML+=`<div class="flip-card reveal" data-flip>
  <div class="flip-inner" onclick="this.parentElement.classList.toggle('flipped')">
   <div class="flip-front bg-cream shadow-lg overflow-hidden flex flex-col">
     <img src="${f.img}" class="h-72 w-full object-contain bg-beige/50 p-2">
     <div class="p-4"><p class="font-serif font-bold text-pickle">${f.name}</p><p class="text-sm text-brown">${f.sub}</p><p class="text-xs mt-2 text-gold">Hover / Tap to discover</p></div>
   </div>
   <div class="flip-back bg-pickle text-cream p-5 flex items-center justify-center text-center shadow-lg">
     <p class="text-sm leading-relaxed">${f.back}</p>
   </div>
  </div></div>`;
});

const pg=document.getElementById('productGrid');
let cart=[];
flavours.forEach(f=>{
 pg.innerHTML+=`<div class="reveal bg-cream rounded-xl p-4 shadow">
   <img src="${f.img}" class="h-56 w-full object-contain bg-beige/50 rounded-lg p-1">
   <p class="font-serif font-bold mt-2 text-pickle">${f.name}</p>
   <select id="size-${f.id}" class="w-full mt-2 p-2 rounded border border-beige text-sm">
     ${sizes.map(s=>`<option value="${s.price}">${s.label} — ₹${s.price}</option>`).join('')}
   </select>
   <div class="flex items-center justify-center gap-3 mt-2">
     <button onclick="qty('${f.id}',-1)" class="bg-beige w-8 h-8 rounded-full">−</button>
     <span id="qty-${f.id}">1</span>
     <button onclick="qty('${f.id}',1)" class="bg-beige w-8 h-8 rounded-full">+</button>
   </div>
   <button onclick="addToCart('${f.id}','${f.name}')" class="w-full mt-3 bg-pickle text-cream py-2 rounded-full text-sm font-semibold hover:bg-pickledark">ADD TO TIJORI</button>
 </div>`;
});
function qty(id,d){const el=document.getElementById('qty-'+id);let v=parseInt(el.textContent)+d;if(v<1)v=1;el.textContent=v;}
function addToCart(id,name){
 const sizeSel=document.getElementById('size-'+id);
 const price=parseInt(sizeSel.value);const sizeLabel=sizeSel.options[sizeSel.selectedIndex].text.split(' — ')[0];
 const q=parseInt(document.getElementById('qty-'+id).textContent);
 cart.push({name,size:sizeLabel,price,qty:q});
 renderCart();toggleCart(true);
}
function renderCart(){
 const box=document.getElementById('cartItems');let total=0;
 box.innerHTML=cart.map((c,i)=>{total+=c.price*c.qty;return `<div class="flex justify-between items-center border-b border-beige pb-2">
   <div><p class="font-semibold text-sm">${c.name}</p><p class="text-xs text-brown">${c.size} × ${c.qty}</p></div>
   <div class="flex items-center gap-2"><span class="text-sm">₹${c.price*c.qty}</span><button onclick="removeItem(${i})" class="text-red-500">✕</button></div>
 </div>`}).join('')||'<p class="text-sm text-brown">Your Tijori is empty.</p>';
 document.getElementById('cartTotal').textContent='₹'+total;
 document.getElementById('cartCount').textContent=cart.reduce((a,c)=>a+c.qty,0);
}
function removeItem(i){cart.splice(i,1);renderCart();}
function toggleCart(open){
 document.getElementById('cartDrawer').style.transform=open?'translateX(0)':'translateX(100%)';
 document.getElementById('cartOverlay').classList.toggle('hidden',!open);
}
function showCheckout(){document.getElementById('checkoutForm').classList.toggle('hidden');}
function buildOrderText(){
 const name=cName.value,phone=cPhone.value,addr=cAddress.value,city=cCity.value,pin=cPin.value;
 let total=cart.reduce((a,c)=>a+c.price*c.qty,0);
 let lines=cart.map(c=>`${c.name} (${c.size}) x${c.qty} - ₹${c.price*c.qty}`).join('\n');
 return `New Order - DADI KI TIJORI\nName: ${name}\nPhone: ${phone}\nAddress: ${addr}, ${city} - ${pin}\n\nItems:\n${lines}\n\nTotal: ₹${total}`;
}
function orderWhatsapp(){window.open('https://wa.me/919892514051?text='+encodeURIComponent(buildOrderText()),'_blank');}
function orderEmail(){window.location.href='mailto:dadikitijori@gmail.com?subject='+encodeURIComponent('New Order - Dadi Ki Tijori')+'&body='+encodeURIComponent(buildOrderText());}

// bingo
const bingoWords=['Pickle with dal-rice','Pickle with paratha','Asked for extra achar','Pickle in my tiffin','Mango pickle lover','Lemon pickle lover','Chilli pickle lover','Love spicy achar','Pickle with khichdi','"Thoda aur achar?"','Have a favourite pickle','Pickle with every meal','Cannot eat without pickle','Homemade achar > everything','Achar in my lunchbox','Ate it straight from the jar','Shared pickle with a friend','Dadi/Nani made pickle','Tried a new flavour','Saved the last spoon','Pickle is never "extra"','Finished the pickle first','Stole pickle from someone','Pickle with curd-rice','FREE SPACE'];
const bg=document.getElementById('bingoGrid');
bingoWords.forEach((w,i)=>{
 const cell=document.createElement('div');
 cell.className='bingo-cell text-[10px] sm:text-xs bg-white rounded p-2 h-20 flex items-center justify-center text-center border border-beige transition cursor-pointer'+(w==='FREE SPACE'?' marked':'');
 cell.textContent=w;
 cell.onclick=()=>cell.classList.toggle('marked');
 bg.appendChild(cell);
});

function submitFeedback(e){e.preventDefault();document.getElementById('feedbackForm').classList.add('hidden');document.getElementById('feedbackThanks').classList.remove('hidden');return false;}
document.querySelectorAll('#stars span').forEach(s=>s.onclick=()=>{document.querySelectorAll('#stars span').forEach((x,i)=>x.style.opacity=i<s.dataset.v?1:.3);});

// click burst
const bE=['🥭','🌶️','🍋','🌿','✨','🗝️'];
document.addEventListener('click',e=>{
 for(let i=0;i<10;i++){
  const p=document.createElement('span');p.className='burst';p.textContent=bE[i%bE.length];
  p.style.left=e.clientX+'px';p.style.top=e.clientY+'px';document.body.appendChild(p);
  const a=(Math.PI*2*i)/10+Math.random()*.5,d=50+Math.random()*50;
  requestAnimationFrame(()=>{p.style.transform=`translate(${Math.cos(a)*d}px,${Math.sin(a)*d}px) rotate(${Math.random()*360}deg) scale(.6)`;p.style.opacity=0;});
  setTimeout(()=>p.remove(),950);
 }
});
// falling ingredients on scroll
const fE=['🥭','🌶️','🍋','🌿','🧄','🫚','🥕','🌶️','🥭','🍋','🫙','🧂'];
let lastY=scrollY,lastT=0;
addEventListener('scroll',()=>{
 const now=Date.now(),down=scrollY>lastY;lastY=scrollY;
 if(!down||now-lastT<350||matchMedia('(prefers-reduced-motion:reduce)').matches||document.querySelectorAll('.fall').length>14)return;
 lastT=now;
 for(let i=0;i<2;i++){
  const p=document.createElement('span');p.className='fall';p.textContent=fE[Math.floor(Math.random()*fE.length)];
  p.style.left=Math.random()*95+'vw';p.style.fontSize=(22+Math.random()*20)+'px';
  p.style.setProperty('--r',(Math.random()*720-360)+'deg');
  p.style.animationDuration=(4+Math.random()*3)+'s';
  document.body.appendChild(p);setTimeout(()=>p.remove(),7500);
 }
},{passive:true});
// letter hover animation on headings
document.querySelectorAll('h1,h2,h3,p.font-serif').forEach(el=>{
 const walk=n=>{[...n.childNodes].forEach(c=>{
  if(c.nodeType===3){
   const frag=document.createDocumentFragment();
   c.textContent.split(/(\s+)/).forEach(t=>{
    if(!t)return;
    if(/^\s+$/.test(t)){frag.appendChild(document.createTextNode(' '));return;}
    const w=document.createElement('span');w.className='w';
    [...t].forEach(ch=>{const k=document.createElement('span');k.className='ch';k.textContent=ch;w.appendChild(k);});
    frag.appendChild(w);
   });
   c.replaceWith(frag);
  } else if(c.nodeType===1 && c.tagName!=='BR') walk(c);
 });};
 walk(el);
});
// scroll reveal
const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('show')}),{threshold:.15});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
</script>
</body>
</html>
